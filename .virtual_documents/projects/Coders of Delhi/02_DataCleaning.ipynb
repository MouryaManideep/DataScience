


import json


def cleaned_data(data):

    # Remove empty name users and updating
    data['users'] = [user for user in data['users'] if user['name'].strip()]

    # Remove duplicate user friends and updating
    for user_f in data['users']:
        user_f['friends'] = list(set(user_f['friends']))

        # print(user_f['friends'], "-->")
        # if user_f['friends']:
        #     print(True)
        # else:
        #     print(False)

    # Remove user who has no connections or liked pages (inactive user)
    data['users'] = [user for user in data['users'] if user['friends'] or user['liked_pages']]

    # Remove duplicate page IDs and updating 
    unique_pages = {}
    for page in data['pages']:
        unique_pages[page['id']] = page
    data['pages'] = unique_pages
    
    return data

# Load the data
data = json.load(open("data2.json"))
# print(type(data))
data = cleaned_data(data)
json.dump(data, open('cleaned_data2.json', 'w'), indent=4)







